# Copy these lines into your .env (or .env.aws). Never commit the real values.
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=DBT_USER
SNOWFLAKE_PRIVATE_KEY_PATH=C:\Users\YOU\.snowflake_keys\dbt_user.p8
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=TRANSFORM_WH
# Only if the schema names Fivetran created differ from these (check: SHOW SCHEMAS IN DATABASE BRONZE)
# BRONZE_SCHEMA_POSTGRES=PG_PUBLIC
# BRONZE_SCHEMA_MYSQL=MYSQL_CRM
# BRONZE_SCHEMA_ORACLE=ORACLE_KLARITY_APP
