# Variable names only. Copy to .env and fill in. Never commit .env.
# The same file drives docker compose (the database servers) and the Python scripts (the clients).

# --- Oracle XE ---
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
ORACLE_PASSWORD=
ORACLE_USER=klarity_app
ORACLE_APP_PASSWORD=

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=crm
MYSQL_ROOT_PASSWORD=
MYSQL_USER=klarity_app
MYSQL_PASSWORD=

# --- PostgreSQL (local container now, AWS RDS later) ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=catalog
PG_USER=klarity_app
PG_PASSWORD=
